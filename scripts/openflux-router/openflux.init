#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=9
start_service() {
  local digest=dcf1fbf57bf535483c15b0aa0bd8bf6a3bc34248c1992db79b7ceeb818172f69
  if ! printf '%s  %s\n' "$digest" /tmp/openflux-core | sha256sum -c - >/dev/null 2>&1; then
    umask 077
    gzip -dc /etc/openflux/openflux.gz > /tmp/openflux-core.new || return 1
    printf '%s  %s\n' "$digest" /tmp/openflux-core.new | sha256sum -c - >/dev/null || return 1
    chmod 700 /tmp/openflux-core.new
    mv /tmp/openflux-core.new /tmp/openflux-core
  fi
  /usr/bin/sing-box check -c /etc/openflux/gateway.json || return 1
  set -- /tmp/openflux-core --config /etc/openflux/client.conf
  if [ -s /etc/openflux/yandex-cookies.txt ]; then
    chmod 600 /etc/openflux/yandex-cookies.txt || return 1
    # The core replays its JSON store after importing Netscape cookies.
    rm -f /tmp/openflux-browser-cookies.json || return 1
    set -- "$@" --yandex-cookies-file /etc/openflux/yandex-cookies.txt --cookie-store /tmp/openflux-browser-cookies.json
  fi
  procd_open_instance client
  procd_set_param command "$@"
  procd_set_param env GOMEMLIMIT=96MiB GOGC=50
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param respawn 3600 10 0
  procd_set_param limits nofile="8192 8192"
  procd_set_param term_timeout 10
  procd_close_instance
  procd_open_instance gateway
  procd_set_param command /etc/openflux/run-gateway.sh
  procd_set_param respawn 3600 10 0
  procd_set_param term_timeout 10
  procd_close_instance
}
stop_service() {
  /etc/openflux/route-down.sh
}
