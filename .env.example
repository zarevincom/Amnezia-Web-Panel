# Generate a unique value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this value private and back it up separately. It is required to decrypt
# VPS credentials and to restore encrypted SQLite backups.
PANEL_MASTER_KEY=replace-with-a-long-random-secret

# Optional published port for the stock docker-compose setup.
APP_PORT=5000
